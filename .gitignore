dist/
build/
out/
coverage/
*.tsbuildinfo

# Packed artifacts
*.tgz

# Self-cleanup staging (profile-patch writes beside the patch, then renames)
*.prune.tmp

# Logs and diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*-sample.txt

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

